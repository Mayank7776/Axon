# Application Settings
APP_NAME="Axon API"
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Security (Change these in your actual .env file!)
SECRET_KEY="generate-a-secure-random-secret-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Settings
DATABASE_URL="postgresql://user:password@localhost:5432/axon_db"
# For SQLite local development, you could use: sqlite:///./axon.db
