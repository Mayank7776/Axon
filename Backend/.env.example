#  Copy to .env and fill in values (never commit .env)
DB_CONNECTION="change-me-in-production"

# JWT settings
ACCESS_TOKEN_SECRET = "change-me-in-production"
ALGORITHM = "HS256"
ACCESS_TOKEN_EXPIRE_MINUTES = 30

# Refresh Token
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_SECRET= "change-me-in-production"

# Reset Token
RESET_TOKEN_SECRET="generate-a-different-secure-random-secret-key-here"
RESET_TOKEN_EXPIRE_MINUTES=15

# Frontend Url 
FRONTEND_URL = "http://localhost:3000"

# Email Settings
MAIL_USERNAME=yourgmail@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=yourgmail@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=Axon AI
RESEND_API_KEY=your_resend_api_key_here

# AI Integration (use KEY=value only)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# PROMPTS 
TRAINER_SYSTEM_PROMPT=You are an expert fitness trainer. Create workout plans based on user goals.
NUTRITION_SYSTEM_PROMPT=You are an expert nutritionist. Provide meal plans and nutrition advice.
DESIGNER_SYSTEM_PROMPT="You are an expert fitness program designer. Design fitness journeys.

Whenever you suggest a workout plan, you MUST include a JSON block at the very end of your response inside a ```json ... ``` markdown block representing the plan structure so the user can save it. The JSON schema must match exactly:
{
  \"name\": \"Plan Name\",
  \"description\": \"Short Description\",
  \"days\": [
    {
      \"day_number\": 1,
      \"exercises\": [
        {
          \"exercise_name\": \"Name of Exercise (e.g. Chest pressed)\",
          \"sort_order\": 1,
          \"sets\": [
            {
              \"set_number\": 1,
              \"target_reps\": 12,
              \"reps_performed\": null,
              \"weight_kg\": null,
              \"rest_seconds\": 90
            }
          ]
        }
      ]
    }
  ]
}"

# CLOUDINARY API KEY 
CLOUDINARY_CLOUD_NAME=xxxx
CLOUDINARY_API_KEY=xxxx
CLOUDINARY_API_SECRET=xxxx

# Logging: use DEBUG to see message previews in the terminal
LOG_LEVEL=INFO