# Application Settings
APP_NAME="Axon API"
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Copy to .env and fill in values (never commit .env)
DB_CONNECTION="postgresql+asyncpg://user:password@localhost:5432/myonix"

# JWT settings
ACCESS_TOKEN_SECRET = "change-me-in-production"
ALGORITHM = "HS256"
ACCESS_TOKEN_EXPIRE_MINUTES = 30

# Refresh Token
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_SECRET= "change-me-in-production"

# Reset Token
RESET_TOKEN_SECRET="generate-a-different-secure-random-secret-key-here"
RESET_TOKEN_EXPIRE_MINUTES=15

# Frontend Url 
FRONTEND_URL = "http://localhost:3000"

# Email Settings
MAIL_USERNAME=yourgmail@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=yourgmail@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=MyOnix AI
RESEND_API_KEY=your_resend_api_key_here


# AI Integration (use KEY=value only)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Logging: use DEBUG to see message previews in the terminal
LOG_LEVEL=INFO